<div class="help-footer">
  <%= link_to 'top of page', '#help-doc-content', 
    data: {
      toggle: 'scrollto-target'
    }, 
    class: 'help-scrollto-top' %>
    &nbsp;
  <%= render partial: 'help/home_link' %>
  <% if display_embedded? %>
    &nbsp;
    <%= link_to help_page_path(library: library, section: section, subsection: subsection) + '#open-in-new-tab',
          title: 'open in new tab',
          class: 'help-open-in-new-tab' do %><% end %>
  <% end %>
</div>
