<% if context == :report_page %>
  <% report_button = button_resolution.buttons[:report] %>
  <% list_records_button = button_resolution.buttons[:list_records] %>
  <%= button_tag report_button.label,
                 name: 'commit',
                 value: report_button.commit,
                 type: 'submit',
                 class: ([button_class] + report_button.classes).join(' '),
                 id: 'report-form-submit-btn' %>
  <%= button_tag list_records_button.label,
                 name: 'commit',
                 value: list_records_button.commit,
                 type: 'submit',
                 class: ([button_class] + list_records_button.classes).join(' ') %>
  <% unless @report.editable_data? %>
    <% count_button = button_resolution.buttons[:count] %>
    <%= button_tag count_button.label,
                   name: 'commit',
                   value: count_button.commit,
                   type: 'submit',
                   class: ([button_class] + count_button.classes).join(' ') %>
    <% unless button_resolution.hide_export_buttons? %>
      <%= submit_tag 'csv', name: :format, value: 'csv', class: button_class if current_admin || current_user&.can?(:export_csv) %>
      <%= submit_tag 'json', id: 'submit_query_to_json', name: :format, value: 'json',
                     class: "#{button_class} target_new_window" if current_admin || current_user&.can?(:export_json) %>
    <% end %>
  <% end %>
<% elsif context == :embedded %>
  <% report_button = button_resolution.buttons[:report] %>
  <%= button_tag report_button.label,
                 name: 'commit',
                 value: report_button.commit,
                 type: 'submit',
                 class: ([button_class] + report_button.classes).join(' '),
                 id: 'report-form-submit-btn' %>
<% end %>
